generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  tasks        Task[]
  usageRecords UsageRecord[]
  files        File[]
  shares       Share[]
  apiKeys      ApiKey[]
  batches      BatchJob[]

  // Usage limits
  dailyUsage   Int      @default(0)
  dailyLimit   Int      @default(10)
  storageUsed  BigInt   @default(0)
  storageLimit BigInt   @default(1073741824) // 1GB default

  @@index([email])
}

enum UserRole {
  FREE
  PRO
  ADMIN
}

model Task {
  id          String     @id @default(cuid())
  type        String
  status      TaskStatus @default(PENDING)
  progress    Int        @default(0)
  inputFile   String
  outputFile  String?
  params      Json?
  error       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  userId  String?
  user    User?     @relation(fields: [userId], references: [id])
  batchId String?
  batch   BatchJob? @relation(fields: [batchId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([batchId])
}

model BatchJob {
  id          String      @id @default(cuid())
  name        String?
  status      TaskStatus  @default(PENDING)
  totalTasks  Int         @default(0)
  completed   Int         @default(0)
  failed      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?

  userId String?
  user   User?  @relation(fields: [userId], references: [id])
  tasks  Task[]

  @@index([userId])
  @@index([status])
}

model UsageRecord {
  id           String   @id @default(cuid())
  toolType     String
  action       String
  fileSize     Int?
  duration     Int?
  processingMs Int?
  createdAt    DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([toolType])
  @@index([userId])
  @@index([createdAt])
}

model File {
  id           String   @id @default(cuid())
  originalName String
  storagePath  String
  mimeType     String
  size         Int
  duration     Float?
  width        Int?
  height       Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  shares Share[]

  @@index([expiresAt])
  @@index([userId])
}

model Share {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  password    String?
  downloads   Int       @default(0)
  maxDownloads Int?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([fileId])
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  lastUsed  DateTime?
  requests  Int      @default(0)
  rateLimit Int      @default(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
