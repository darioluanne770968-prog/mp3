    }
  ],
  "shortcuts": [
    {
      "name": "Audio Tools",
      "short_name": "Audio",
      "description": "Audio editing tools",
      "url": "/audio",
      "icons": [{ "src": "/icons/audio.png", "sizes": "192x192" }]
    },
    {
      "name": "Video Tools",
      "short_name": "Video",
      "description": "Video editing tools",
      "url": "/video",
      "icons": [{ "src": "/icons/video.png", "sizes": "192x192" }]
