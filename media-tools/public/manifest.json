      "description": "PDF editing tools",
      "url": "/pdf",
      "icons": [{ "src": "/icons/pdf.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["audio/*", "video/*", "application/pdf", "image/*"]
        }
      ]
    }
  }
